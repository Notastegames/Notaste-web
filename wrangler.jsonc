{
  // Cloudflare config: serves everything in ./public as a static site.
  // The Worker name in the Cloudflare dashboard must match "name" below.
  "name": "notaste-web",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Needed for the preview link Cloudflare builds for every branch and pull request.
  "previews": {}
}
